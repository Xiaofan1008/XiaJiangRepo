%% ============================================================
% NN_SpikeRecovery_RandomEvent_v1.m
% Step 2 of the PULSE-TRAIN artifact recovery pipeline (marmoset NN data).
% SIMULATION / CHECK version: after the normal recovery of a level, a random share of ALL spikes in
% the window after that level's pulse is REMOVED, with a percentage and a window length set per level.
% NN_SpikeRecovery_v1, _Random_v1, _RandomSpikes_v1 and their output files are NOT touched.
%
% WHAT THIS DOES (per level L >= 2)
%   1. Normal recovery (as v1): for every target trial the window [0, win_end) after ITS trigger is
%      blanked and filled from the SAME relative window of its paired trial of level L-1 (already
%      processed data). win_end = first spike after the last pulse (NN_FirstSpikeTime_v1) capped at
%      lastPulse + cap_ms; if no spike was found: lastPulse + fallback_ms.
%   2. Thinning: in the window  [t_L, t_L + event_ms)  after the last pulse t_L of the level, ALL spikes
%      (the substituted ones AND the genuine ones) of all trials of the level are pooled, per channel,
%      and exactly round(percent/100 * N) of them are kept at random (fixed seed). The rest are removed.
%   3. Higher levels copy this stretch unchanged (each level copies [0, win_end) from the level below),
%      so every pulse of the final train carries the percentage of ITS OWN level.
%   Level 1 has no source and is never changed (its response stays at 100 %).
%   percent = 100 changes nothing: with every percent at 100 the result is identical to v1.
%
% THIS IS A SIMULATION, NOT A RECOVERY: it deliberately removes real spikes, to reduce the response to
%   each pulse by a KNOWN percentage, so you can check whether the analysis finds that reduction
%   (e.g. added spikes should follow the percentage; the count should flatten). Use a separate file.
%
% SETTINGS PER LEVEL (levels start at 2)
%   sim_default / seq_default   = [fallback_ms  cap_ms  percent  event_ms]
%   sim_override / seq_override = rows [level fallback_ms cap_ms percent event_ms] for levels that differ.
%   Levels not listed use the default block, so event_ms of the default is also the length used for
%   the levels you do not specify and for the last level (which has no next pulse).
%   fallback_ms / cap_ms : the substitution window (pulse -> first spike), as in v1.
%   percent             : share of the spikes kept in [t_L, t_L + event_ms)   (100 = nothing removed)
%   event_ms            : length of that window (e.g. 10 = next pulse for sim, 5 for seq).
%   Keep event_ms <= the pulse spacing: the part after the next pulse is overwritten by the next
%   level's own data (a warning is printed if event_ms is longer than the spacing).
%   sim = simultaneous pattern (levels 1..n); seq = sequential pattern (levels 1..2n, AB and BA share the block).
%
% NOTE: spontaneous spikes in the window are thinned too (not only the response to the pulse), so at
%   low percentages the "added spikes" of a level can become slightly negative: an artifact of this simulation.
%
% OUTPUT (new files next to the input; suffix out_suffix, default RandomEvent)
%   *.sp_xia_TrainRecovery_<out_suffix>.mat           sp_clipped (times only), blank_end_ms, srcTrial,
%                                                       isRecovered, recLog, Recovery_params, FS
%   *.sp_xia_waveforms_TrainRecovery_<out_suffix>.mat sp_waveforms (only if do_waveforms = true)
%   recLog(k) holds, per condition, the number of spikes in the thinning window and how many were kept.
%
% CHECK AGAINST v1: set compare_v1_file to the v1 *.sp_xia_TrainRecovery.mat. If every percent is
%   100 and the fallback / cap equal the ones of the v1 run, the result must be identical.
% ============================================================
clear all; clc;

%% ================= USER SETTINGS =================
analysisPath = '/Volumes/MACData/Data/Data_Xia/AnalysisFunctions/';

data_folder = '/Volumes/MACData/Data/Data_Xia/CJ287/Xia_Train_15Pulses_3_100Hz_30uA';

times_file = '/Volumes/MACData/Data/Data_Xia/CJ287/Xia_Train_15Pulses_3_100Hz_30uA/Xia_Train_15Pulses_3_100Hz_30uA.sp_xia_filtered.mat';
                   % the FILTERED spike-times file of this dataset (same one used in step 1).
                   % The other files are found next to it by name:
                   %   *.sp_xia_waveforms_filtered.mat  (if do_waveforms)
                   %   *.sp_xia_FirstSpikeTimes.mat     (from step 1)

out_suffix   = 'RandomEvent';   % output files: *.sp_xia_TrainRecovery_<out_suffix>.mat
do_waveforms = true;       % true : process waveform rows too, save the separate waveform file
                           % false: spike times only (smaller, faster), no waveform file
FS = 30000;

% ---- settings per level: [fallback_ms  cap_ms  percent  event_ms]  (levels start at 2) ----
sim_default  = [10 10 100 10];  % simultaneous pattern, every level not listed in sim_override
sim_override = [
                2,10,10,60,10;
                9,10,10,60,10;
                10,10,10,50,10;
                11,10,10,40,10;
                12,10,10,30,10;
                13,10,10,30,10;
                14,10,10,20,10;
                15,10,10,20,20;
                ];              % rows [level fallback_ms cap_ms percent event_ms]
seq_default  = [10 10 100 5];   % sequential pattern (AB and BA), every level not listed in seq_override
seq_override = [
                25,10,10,40,5;
                26,10,10,40,5;
                27,10,10,15,5;
                28,10,10,15,5;
                29,10,10,5,5;
                30,10,10,5,20;
                ];              % rows [level fallback_ms cap_ms percent event_ms]

rand_seed = 1;                  % seed of the random choice of spikes (percent < 100)

compare_v1_file = '';           % '' = no comparison; or the v1 *.sp_xia_TrainRecovery.mat (see header)

%% ================= LOAD =================
if ~isempty(analysisPath), addpath(genpath(analysisPath)); end
assert(isfolder(data_folder), 'Folder not found: %s', data_folder);
cd(data_folder);

assert(contains(times_file, '.sp_xia_filtered.mat'), 'times_file must end in .sp_xia_filtered.mat');
wf_file  = strrep(times_file, '.sp_xia_filtered.mat', '.sp_xia_waveforms_filtered.mat');
fst_file = strrep(times_file, '.sp_xia_filtered.mat', '.sp_xia_FirstSpikeTimes.mat');
assert(isfile(fst_file), 'Cannot find %s -- run NN_FirstSpikeTime_v1 first.', fst_file);
assert(~isempty(out_suffix) && ischar(out_suffix), 'out_suffix must be a non-empty text.');

if do_waveforms
    assert(isfile(wf_file), 'Cannot find %s.', wf_file);
    W = load(wf_file);
    assert(isfield(W,'sp_waveforms'), 'sp_waveforms not found in %s.', wf_file);
    rows = W.sp_waveforms;  clear W
    if isfile(times_file) && ~isempty(whos('-file', times_file, 'fs')), tmp = load(times_file,'fs'); FS = tmp.fs; end
else
    assert(isfile(times_file), 'Cannot find %s.', times_file);
    T = load(times_file);
    assert(isfield(T,'sp_clipped'), 'sp_clipped not found in %s.', times_file);
    rows = T.sp_clipped;
    if isfield(T,'fs'), FS = T.fs; end
    clear T
end
nChn = numel(rows);

Sf = load(fst_file);
need = {'firstSpikeTimes','lastPulse_ms','trialCond','condTable','n_Trials'};
assert(all(isfield(Sf, need)), '%s is missing expected fields -- re-run NN_FirstSpikeTime_v1.', fst_file);
firstSpikeTimes = Sf.firstSpikeTimes;
lastPulse_ms    = Sf.lastPulse_ms(:);
trialCond       = Sf.trialCond(:);
condTable       = Sf.condTable;
n_Trials        = Sf.n_Trials;
assert(numel(firstSpikeTimes) == nChn, 'FirstSpikeTimes has %d channels, spike file has %d.', numel(firstSpikeTimes), nChn);
if isfield(Sf,'FS') && Sf.FS ~= FS, warning('NSR:fs', 'FS differs between files (%g vs %g).', Sf.FS, FS); end

% triggers (same reading as step 1; skips macOS "._" files)
f = dir('*.trig.dat'); f = f(~startsWith({f.name}, '.'));
assert(~isempty(f), 'No *.trig.dat in %s.', data_folder);
fid = fopen(f(1).name, 'r'); trig = fread(fid, [1 inf], 'double'); fclose(fid);
trig = trig(:);
trigOK = false(n_Trials,1);
nUse = min(numel(trig), n_Trials);
trigOK(1:nUse) = trig(1:nUse) > 0;
t0_ms = nan(n_Trials,1); t0_ms(1:nUse) = trig(1:nUse)/FS*1000;

%% ================= LEVEL ORDER (CHAIN DEPTH) =================
nCond  = numel(condTable);
srcOf  = [condTable.sourceCond]';            % NaN = no source
depth  = zeros(nCond,1);
for it = 1:nCond+1
    changed = false;
    for k = 1:nCond
        if ~isnan(srcOf(k))
            d = depth(srcOf(k)) + 1;
            if d ~= depth(k), depth(k) = d; changed = true; end
        end
    end
    if ~changed, break; end
    if it == nCond+1, error('Source chain has a loop -- check the condTable.'); end
end
maxDepth = max(depth);
fprintf('%d conditions, chain depth 0..%d (0 = not recovered).\n', nCond, maxDepth);

%% ================= SETTINGS PER CONDITION =================
chkSet_('sim', sim_default, sim_override);
chkSet_('seq', seq_default, seq_override);
assert(rand_seed == round(rand_seed), 'rand_seed must be an integer.');

kindK = arrayfun(@(c) char(c.kind), condTable, 'UniformOutput', false);  kindK = kindK(:)';   % 1 x nCond
lvlK  = arrayfun(@(c) double(c.level), condTable);  lvlK = lvlK(:);                          % nCond x 1
lpK   = arrayfun(@(c) double(c.lastPulse_ms), condTable);  lpK = lpK(:);                     % nCond x 1
fbK = nan(nCond,1);  capK = nan(nCond,1);  pctK = nan(nCond,1);  evK = nan(nCond,1);  spK = nan(nCond,1);
for k = 1:nCond
    if depth(k) == 0, continue; end
    if strcmp(kindK{k}, 'sim')
        def = sim_default;  ov = sim_override;
    else
        if ~any(strcmp(kindK{k}, {'AB','BA'}))
            warning('NSR:kind', 'cond %d has kind ''%s'': the seq settings are used.', k, kindK{k});
        end
        def = seq_default;  ov = seq_override;
    end
    s = def;
    if ~isempty(ov)
        r = find(ov(:,1) == lvlK(k), 1);
        if ~isempty(r), s = ov(r,2:5); end
    end
    fbK(k) = s(1);  capK(k) = s(2);  pctK(k) = s(3);  evK(k) = s(4);
    spK(k) = lpK(k) - lpK(srcOf(k));                % pulse spacing of this step (ms)
end
% overrides for levels that do not exist
for pp = 1:2
    if pp == 1, nm = 'sim'; ov = sim_override; isP = strcmp(kindK, 'sim');
    else,       nm = 'seq'; ov = seq_override; isP = ~strcmp(kindK, 'sim'); end
    if isempty(ov), continue; end
    idxP = find(isP & depth(:)' > 0);
    mx = max([0; lvlK(idxP(:))]);
    for r = 1:size(ov,1)
        if ov(r,1) > mx, warning('NSR:level', '%s_override: level %g does not exist (max level %d).', nm, ov(r,1), mx); end
    end
end

fprintf('\n--- SETTINGS PER CONDITION ---\n  cond  kind  level  source   fallback(ms)  cap(ms)  percent  event(ms)  spacing(ms)\n');
for k = find(depth(:)' > 0)
    fprintf('  %3d   %-4s   %3d    %3d      %6.2f      %6.2f   %5.1f    %6.2f     %6.2f\n', k, kindK{k}, lvlK(k), srcOf(k), fbK(k), capK(k), pctK(k), evK(k), spK(k));
    if pctK(k) < 100 && evK(k) > spK(k) + 1e-9
        warning('NSR:event', 'cond %d (level %d): event_ms %g is longer than the pulse spacing %g ms; the part after the next pulse is overwritten by the next level.', k, lvlK(k), evK(k), spK(k));
    end
end
fprintf('random seed %d | output suffix _%s\n', rand_seed, out_suffix);

%% ================= CHAINED RECOVERY + THINNING =================
blank_end_ms = cell(nChn,1);
for ch = 1:nChn, blank_end_ms{ch} = nan(n_Trials,1); end
srcTrial = nan(n_Trials,1);
isRecovered = false(n_Trials,1);

% recLog(k): per condition counts
recLog = repmat(struct('cond',0,'depth',0,'source',NaN,'fallback_ms',NaN,'cap_ms',NaN,'percent',NaN,'event_ms',NaN, ...
    'nValid',0,'nTargets',0,'nDetected',0,'nFallback',0,'nAdded',0,'nDeleted',0,'nWindow',0,'nKept',0,'nWindowGenuine',0), nCond, 1);
for k = 1:nCond
    recLog(k).cond = k; recLog(k).depth = depth(k); recLog(k).source = srcOf(k);
    recLog(k).fallback_ms = fbK(k); recLog(k).cap_ms = capK(k); recLog(k).percent = pctK(k); recLog(k).event_ms = evK(k);
end

for d = 1:maxDepth
    condsD = find(depth == d)';
    fprintf('\n--- Level depth %d: conditions %s ---\n', d, mat2str(condsD));

    % pair every target trial with a source trial (same for all channels)
    pairs = cell(nCond,1);
    for k = condsD
        trT = find(trialCond == k & trigOK & isfinite(lastPulse_ms));
        recLog(k).nValid = numel(trT);
        if isempty(trT), continue; end
        trS = find(trialCond == srcOf(k) & trigOK);
        if isempty(trS)
            warning('NSR:nosrc', 'cond %d: source cond %d has no usable trial. Left unrecovered.', k, srcOf(k));
            continue;
        end
        sIdx = mod((1:numel(trT))-1, numel(trS)) + 1;
        sSel = trS(sIdx);
        pairs{k} = [trT(:), sSel(:)];
        srcTrial(trT) = sSel;
        isRecovered(trT) = true;
        recLog(k).nTargets = numel(trT);
    end

    for ch = 1:nChn
        R = rows{ch};
        if isempty(R) && ~any(cellfun(@(p) ~isempty(p), pairs)), continue; end
        tt = R(:,1);                                  % sorted spike times (ms)
        delMask = false(size(R,1),1);
        adds = {};
        for k = condsD
            P = pairs{k};
            if isempty(P), continue; end
            fb = fbK(k);  cp = capK(k);  pc = pctK(k);  ev = evK(k);
            nq = size(P,1);
            Bin  = cell(nq,1);                        % substituted spikes inside the thinning window (candidates)
            Gidx = cell(nq,1);                        % row numbers of genuine spikes inside the thinning window (candidates)
            for q = 1:nq
                trT = P(q,1); trS = P(q,2);
                first_ms = firstSpikeTimes{ch}(trT);
                lp = lastPulse_ms(trT);
                if isfinite(first_ms) && first_ms > 0
                    win_end = min(first_ms, lp + cp);
                    recLog(k).nDetected = recLog(k).nDetected + 1;
                else
                    win_end = lp + fb;
                    recLog(k).nFallback = recLog(k).nFallback + 1;
                end
                if win_end <= 0, continue; end
                blank_end_ms{ch}(trT) = win_end;

                % delete original target spikes in [0, win_end)
                a = t0_ms(trT);  b = a + win_end;
                i1 = lb_(tt, a);  i2 = lb_(tt, b);          % rows i1..i2-1 are inside
                if i2 > i1
                    delMask(i1:i2-1) = true;
                    recLog(k).nDeleted = recLog(k).nDeleted + (i2 - i1);
                end

                % source trial, same relative window, split at the last pulse
                sa = t0_ms(trS);  sb = sa + win_end;
                j1 = lb_(tt, sa);  j2 = lb_(tt, sb);
                jm = min(max(lb_(tt, sa + lp), j1), j2);   % rows j1..jm-1: [0, t_L)   rows jm..j2-1: [t_L, win_end)
                if jm > j1                                  % before the last pulse: copied completely
                    add = R(j1:jm-1, :);
                    add(:,1) = add(:,1) - sa + a;
                    adds{end+1} = add; %#ok<AGROW>
                    recLog(k).nAdded = recLog(k).nAdded + size(add,1);
                end
                if j2 > jm                                  % substituted spikes of [t_L, win_end)
                    add = R(jm:j2-1, :);
                    add(:,1) = add(:,1) - sa + a;
                    inWin = (add(:,1) - a) < (lp + ev);     % inside the thinning window -> candidates
                    if any(~inWin)                          % beyond the window: kept completely
                        adds{end+1} = add(~inWin, :); %#ok<AGROW>
                        recLog(k).nAdded = recLog(k).nAdded + nnz(~inWin);
                    end
                    if any(inWin), Bin{q} = add(inWin, :); end
                end
                % genuine target spikes in [win_end, t_L + event_ms)
                if lp + ev > win_end
                    g2 = lb_(tt, a + lp + ev);
                    if g2 > i2, Gidx{q} = (i2:g2-1)'; end
                end
            end

            % pool: substituted candidates first, then genuine ones; keep exactly pc % at random
            Ball = vertcat(Bin{:});   nB = size(Ball, 1);
            Gall = vertcat(Gidx{:});  nG = numel(Gall);
            N = nB + nG;
            if N > 0
                if pc >= 100
                    sel = 1:N;
                elseif pc <= 0
                    sel = [];
                else
                    nKeep = round(pc/100*N);
                    rs = RandStream('mt19937ar', 'Seed', rand_seed + 10000*k + ch);
                    sel = sort(randperm(rs, N, nKeep));
                end
                keepB = sel(sel <= nB);
                keepG = sel(sel > nB) - nB;
                if ~isempty(keepB)
                    adds{end+1} = Ball(keepB, :); %#ok<AGROW>
                    recLog(k).nAdded = recLog(k).nAdded + numel(keepB);
                end
                if nG > 0
                    dropG = true(nG, 1);  dropG(keepG) = false;
                    delMask(Gall(dropG)) = true;
                    recLog(k).nDeleted = recLog(k).nDeleted + nnz(dropG);
                end
                recLog(k).nWindow = recLog(k).nWindow + N;
                recLog(k).nWindowGenuine = recLog(k).nWindowGenuine + nG;
                recLog(k).nKept = recLog(k).nKept + numel(sel);
            end
        end
        if isempty(adds) && ~any(delMask), continue; end
        R(delMask,:) = [];
        if ~isempty(adds), R = [R; vertcat(adds{:})]; end %#ok<AGROW>
        [~,o] = sort(R(:,1));
        rows{ch} = R(o,:);
    end

    for k = condsD
        fprintf(' cond %3d %-4s lvl %2d (source %3d) fb %g cap %g pct %g%% event %g ms: %2d / %2d trials | window end from spike %d, fallback %d | deleted %d, added %d | thinning window: %d spikes (%d genuine), %d kept\n', ...
            k, kindK{k}, lvlK(k), srcOf(k), fbK(k), capK(k), pctK(k), evK(k), recLog(k).nTargets, recLog(k).nValid, ...
            recLog(k).nDetected, recLog(k).nFallback, recLog(k).nDeleted, recLog(k).nAdded, ...
            recLog(k).nWindow, recLog(k).nWindowGenuine, recLog(k).nKept);
    end
end

%% ================= SUMMARY =================
fprintf('\n--- SPIKES KEPT IN THE THINNING WINDOW PER LEVEL (kept / spikes in the window, all channels and trials) ---\n');
for pp = 1:2
    if pp == 1, nm = 'sim'; sel = find(depth(:)' > 0 & strcmp(kindK, 'sim'));
    else,       nm = 'seq'; sel = find(depth(:)' > 0 & ~strcmp(kindK, 'sim')); end
    if isempty(sel), continue; end
    fprintf(' %s: ', nm);
    for k = sel, fprintf('L%d %d/%d  ', lvlK(k), recLog(k).nKept, recLog(k).nWindow); end
    fprintf('\n');
end

%% ================= SAVE =================
Recovery_params = struct('times_file',times_file,'do_waveforms',do_waveforms,'fst_file',fst_file, ...
    'condTable',condTable,'trialCond',trialCond,'depth',depth,'sourceCond',srcOf, ...
    'fallback_ms_k',fbK,'cap_ms_k',capK,'percent_k',pctK,'event_ms_k',evK,'rand_seed',rand_seed, ...
    'sim_default',sim_default,'sim_override',sim_override,'seq_default',seq_default,'seq_override',seq_override, ...
    'isRecovered',isRecovered,'out_suffix',out_suffix, ...
    'percent_means','share of ALL spikes kept in [last pulse, last pulse + event_ms) (simulation: real spikes are removed)');
if do_waveforms
    sp_clipped = cellfun(@col1_, rows, 'UniformOutput', false);
    sp_waveforms = rows;
else
    sp_clipped = rows;
end
times_out = strrep(times_file, '.sp_xia_filtered.mat', ['.sp_xia_TrainRecovery_' out_suffix '.mat']);
save(times_out, 'sp_clipped', 'blank_end_ms', 'srcTrial', 'isRecovered', 'recLog', 'Recovery_params', 'FS', '-v7.3');
fprintf('\nSaved spike times to %s\n', times_out);
if do_waveforms
    wf_out = strrep(times_file, '.sp_xia_filtered.mat', ['.sp_xia_waveforms_TrainRecovery_' out_suffix '.mat']);
    save(wf_out, 'sp_waveforms', 'blank_end_ms', 'isRecovered', 'FS', '-v7.3');
    fprintf('Saved waveforms to %s (delete after waveform checking)\n', wf_out);
end

%% ================= OPTIONAL: COMPARE WITH v1 =================
if ~isempty(compare_v1_file)
    assert(isfile(compare_v1_file), 'compare_v1_file not found: %s', compare_v1_file);
    C = load(compare_v1_file, 'sp_clipped', 'Recovery_params');
    fprintf('\n--- COMPARISON WITH v1 (%s) ---\n', compare_v1_file);
    if isfield(C.Recovery_params,'fallback_ms') && isfield(C.Recovery_params,'cap_ms')
        fprintf('v1 run used fallback %g ms, cap %g ms.\n', C.Recovery_params.fallback_ms, C.Recovery_params.cap_ms);
    end
    if any(pctK(depth > 0) < 100)
        fprintf('Some percent values are < 100: the result is NOT expected to equal v1.\n');
    end
    nSame = 0;
    for ch = 1:nChn
        a_ = sp_clipped{ch};  b_ = C.sp_clipped{ch};
        if isequal(a_(:), b_(:)), nSame = nSame + 1;
        else, fprintf('  channel %2d differs: %d vs %d spikes\n', ch, numel(a_), numel(b_)); end
    end
    fprintf('identical in %d of %d channels\n', nSame, nChn);
end

%% ================= HELPERS =================
function i = lb_(s, x)
% first index with s(i) >= x (numel(s)+1 if none); s sorted ascending
lo = 1; hi = numel(s) + 1;
while lo < hi
    m = floor((lo + hi)/2);
    if s(m) < x, lo = m + 1; else, hi = m; end
end
i = lo;
end

function c = col1_(x)
if isempty(x), c = x; else, c = x(:,1); end
end

function chkSet_(name, def, ov)
% validate the settings block of one pattern
assert(isnumeric(def) && numel(def) == 4, '%s_default must be [fallback_ms cap_ms percent event_ms].', name);
assert(def(1) > 0 && def(2) > 0, '%s_default: fallback_ms and cap_ms must be > 0.', name);
assert(def(3) >= 0 && def(3) <= 100, '%s_default: percent must be between 0 and 100.', name);
assert(def(4) > 0, '%s_default: event_ms must be > 0.', name);
if isempty(ov), return; end
assert(isnumeric(ov) && size(ov,2) == 5, '%s_override must have 5 columns: [level fallback_ms cap_ms percent event_ms].', name);
assert(all(ov(:,1) >= 2 & ov(:,1) == round(ov(:,1))), '%s_override: levels must be integers >= 2 (level 1 is never changed).', name);
assert(numel(unique(ov(:,1))) == size(ov,1), '%s_override: a level is listed more than once.', name);
assert(all(ov(:,2) > 0 & ov(:,3) > 0), '%s_override: fallback_ms and cap_ms must be > 0.', name);
assert(all(ov(:,4) >= 0 & ov(:,4) <= 100), '%s_override: percent must be between 0 and 100.', name);
assert(all(ov(:,5) > 0), '%s_override: event_ms must be > 0.', name);
end
