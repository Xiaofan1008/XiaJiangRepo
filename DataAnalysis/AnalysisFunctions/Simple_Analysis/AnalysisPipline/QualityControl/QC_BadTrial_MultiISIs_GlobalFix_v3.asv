%% ========================================================================
% MULTI-ISI MANUAL BAD-TRIAL ENTRY
%
% PURPOSE
%   Add or remove manually identified bad trials using the TrialSummary
%   created by:
%       <base_name>_MultiISI_TrialSpikeCounts_PerTrial.mat
% TRIAL IDENTIFICATION
%   Trials are entered using:
%       Set + Amplitude + PTD + ConditionTrialIndex
%   The script converts ConditionTrialIndex into the corresponding
%   AbsoluteTrialID before updating BadTrials.
% GLOBAL CHANGES
%   Global trials are added to or removed from every recording channel.
% CHANNEL-SPECIFIC CHANGES
%   Channel-specific trials are added to or removed from selected channels.
% SAFETY
%   - Every entry is validated before any file is modified.
%   - If one entry is invalid, the script stops without saving.
%   - Conflicting additions and removals are rejected.
%   - An existing output is backed up before it is overwritten.
% OUTPUT
%   <base_name>.MultiISIsBadTrials.mat
% MAIN VARIABLES
%   BadTrials{channel_index}
%   GoodTrials{channel_index}
% ========================================================================

clear;

%% ============================ USER SETTINGS ===========================

data_folder = ...
    '/Volumes/MACData/Data/Data_Xia/DX023/Xia_ISI_SimSeq1';

% Numerical tolerances used when matching conditions
Amp_Tol_uA = 0.001;
PTD_Tol_ms = 0.001;

% Back up an existing bad-trial file before overwriting it
Create_Backup_If_Output_Exists = true;

%% =====================================================================
% GLOBAL ADDITIONS
% Format:
%   {Set, Amp_uA, PTD_ms, [ConditionTrialIndices]}
% Every converted absolute trial will be added to every channel.
% Example:
% Global_Additions = {
%     1,  5,   0,  [1 3 4 7];
%     1,  5,   3,  [2 6];
%     1, 10,  10,  [1 9];
%     2,  5,   5,  [3 7 8];
% };
% ======================================================================

Global_Additions = {
    % Set, Amp_uA, PTD_ms, [ConditionTrialIndices]
    1,5,0, [2 7 12 13 14 19 25  26  27  28  29];
    1,5,3, [3 5 7 23 28 29 30];
    1,5,4, [2 3 5 6 10 15 17 18 22 23 24 25 27 29 30];
    1,5,5, [1 2 6 15 24 25 26];
    1,5,6, [6 8 11 12 14 16 17 20 21 22 23 24 25 29 30];
    1,5,7, [7 8 10 14 16 23 29];
    1,5,8, [4 7 11 12 13 14 21 22 25 26 27 28 30];
    1,5,9, [5 13 14 15 16 20 22 23 25 27 28];
    1,5,10, [3 4 6 14 23 28 29];
    1,5,11, [];
    1,5,12, [];
    1,5,13, [];
    1,5,14, [];
    1,5,15, [];
    1,5,17, [];
    1,5,20, [];

    1,10,0, [];
    1,10,3, [];
    1,10,4, [];
    1,10,5, [];
    1,10,6, [];
    1,10,7, [];
    1,10,8, [];
    1,10,9, [];
    1,10,10, [];
    1,10,11, [];
    1,10,12, [];
    1,10,13, [];
    1,10,14, [];
    1,10,15, [];
    1,10,17, [];
    1,10,20, [];

    2,5,0, [];
    2,5,3, [];
    2,5,4, [];
    2,5,5, [];
    2,5,6, [];
    2,5,7, [];
    2,5,8, [];
    2,5,9, [];
    2,5,10, [];
    2,5,11, [];
    2,5,12, [];
    2,5,13, [];
    2,5,14, [];
    2,5,15, [];
    2,5,17, [];
    2,5,20, [];

    2,10,0, [];
    2,10,3, [];
    2,10,4, [];
    2,10,5, [];
    2,10,6, [];
    2,10,7, [];
    2,10,8, [];
    2,10,9, [];
    2,10,10, [];
    2,10,11, [];
    2,10,12, [];
    2,10,13, [];
    2,10,14, [];
    2,10,15, [];
    2,10,17, [];
    2,10,20, [];
   

};

%% =====================================================================
% GLOBAL REMOVALS
%
% Format:
%   {Set, Amp_uA, PTD_ms, [ConditionTrialIndices]}
%
% Every converted absolute trial will be removed from every channel.
%
% Example:
% Global_Removals = {
%     1, 5, 0, [3];
% };
% ======================================================================

Global_Removals = {
    % Set, Amp_uA, PTD_ms, [ConditionTrialIndices]

};

%% =====================================================================
% CHANNEL-SPECIFIC ADDITIONS
%
% Format:
%   {Set, Amp_uA, PTD_ms, [ChannelIndices], [ConditionTrialIndices]}
%
% Each listed condition trial will be added to each listed channel.
%
% Example:
% Channel_Additions = {
%     1,  5,   3,  22,       [2 5 8];
%     1,  5,   5,  [22 24],  [4 7];
%     2, 10,  15,  48,       [1 3];
% };
% ======================================================================

Channel_Additions = {
    % Set, Amp_uA, PTD_ms, [ChannelIndices], [ConditionTrialIndices]

};

%% =====================================================================
% CHANNEL-SPECIFIC REMOVALS
%
% Format:
%   {Set, Amp_uA, PTD_ms, [ChannelIndices], [ConditionTrialIndices]}
%
% Example:
% Channel_Removals = {
%     1, 5, 3, 22, [2];
% };
% ======================================================================

Channel_Removals = {
    % Set, Amp_uA, PTD_ms, [ChannelIndices], [ConditionTrialIndices]

};

%% =========================== INITIAL CHECKS ===========================

if ~isfolder(data_folder)
    error('Dataset folder does not exist:\n%s',data_folder);
end

if ~isscalar(Amp_Tol_uA) || ...
        ~isfinite(Amp_Tol_uA) || ...
        Amp_Tol_uA <= 0

    error('Amp_Tol_uA must be a positive number.');
end

if ~isscalar(PTD_Tol_ms) || ...
        ~isfinite(PTD_Tol_ms) || ...
        PTD_Tol_ms <= 0

    error('PTD_Tol_ms must be a positive number.');
end

% Return to the original folder when the script finishes
starting_folder = pwd;
cleanup_object = onCleanup(@() cd(starting_folder)); %#ok<NASGU>

cd(data_folder);

fprintf('\n============================================================\n');
fprintf('MULTI-ISI MANUAL BAD-TRIAL ENTRY\n');
fprintf('============================================================\n');
fprintf('Dataset: %s\n',data_folder);

%% ===================== LOAD THE SPIKE-COUNT TABLE =====================

count_file_candidates = dir( ...
    '*_MultiISI_TrialSpikeCounts_PerTrial.mat');

% Ignore macOS metadata files and timestamped backups
keep_file = true(size(count_file_candidates));

for file_index = 1:numel(count_file_candidates)

    this_name = count_file_candidates(file_index).name;

    if startsWith(this_name,'._') || ...
            contains(this_name,'BACKUP','IgnoreCase',true)

        keep_file(file_index) = false;
    end
end

count_file_candidates = count_file_candidates(keep_file);

if isempty(count_file_candidates)
    error(['No *_MultiISI_TrialSpikeCounts_PerTrial.mat file was found.\n' ...
        'Run the multi-ISI spike-count table script first.']);
end

if numel(count_file_candidates) > 1
    error(['Multiple multi-ISI spike-count files were found.\n' ...
        'Please keep only the intended current result in this folder.']);
end

count_file = count_file_candidates(1).name;

required_count_variables = { ...
    'TrialSummary','selected_channels'};

available_variables = who('-file',count_file);

for variable_index = 1:numel(required_count_variables)

    variable_name = required_count_variables{variable_index};

    if ~ismember(variable_name,available_variables)
        error('Spike-count file is missing variable: %s', ...
            variable_name);
    end
end

CountLoad = load(count_file, ...
    'TrialSummary','selected_channels');

TrialSummary = CountLoad.TrialSummary;
selected_channels = double(CountLoad.selected_channels(:).');

if ~istable(TrialSummary)
    error('TrialSummary must be a MATLAB table.');
end

required_table_columns = { ...
    'AbsoluteTrialID', ...
    'ConditionTrialIndex', ...
    'SetIndex', ...
    'Amplitude_uA', ...
    'PTD_ms'};

table_columns = TrialSummary.Properties.VariableNames;

for column_index = 1:numel(required_table_columns)

    column_name = required_table_columns{column_index};

    if ~ismember(column_name,table_columns)
        error('TrialSummary is missing column: %s',column_name);
    end
end

if isempty(selected_channels)
    error('selected_channels is empty in the spike-count file.');
end

if any(~isfinite(selected_channels)) || ...
        any(selected_channels < 1) || ...
        any(fix(selected_channels) ~= selected_channels)

    error('selected_channels contains invalid channel indices.');
end

selected_channels = unique(selected_channels,'stable');
nChannels = max(selected_channels);

% Confirm that the selected channel indices are continuous from 1
expected_channels = 1:nChannels;

if ~isequal(selected_channels,expected_channels)
    warning(['selected_channels is not continuous from 1 to %d. ' ...
        'BadTrials will still contain %d channel cells.'], ...
        nChannels,nChannels);
end

all_absolute_trial_ids = ...
    double(TrialSummary.AbsoluteTrialID(:).');

if any(~isfinite(all_absolute_trial_ids)) || ...
        any(all_absolute_trial_ids < 1) || ...
        any(fix(all_absolute_trial_ids) ~= ...
        all_absolute_trial_ids)

    error('TrialSummary contains invalid AbsoluteTrialID values.');
end

if numel(unique(all_absolute_trial_ids)) ~= ...
        numel(all_absolute_trial_ids)

    error('TrialSummary contains duplicate AbsoluteTrialID values.');
end

nTrials = numel(all_absolute_trial_ids);

base_name = erase( ...
    count_file, ...
    '_MultiISI_TrialSpikeCounts_PerTrial.mat');

fprintf('Spike-count source: %s\n',count_file);
fprintf('Trials available: %d\n',nTrials);
fprintf('Channel cells required: %d\n',nChannels);

%% ====================== OUTPUT BAD-TRIAL FILE =========================

bad_filename = sprintf( ...
    '%s.MultiISIsBadTrials.mat',base_name);

save_file_path = fullfile(data_folder,bad_filename);

%% ================== LOAD EXISTING BAD-TRIAL RESULT ====================

BadTrials = cell(nChannels,1);
ExistingBadTrialHistory = struct([]);

if isfile(save_file_path)

    ExistingLoad = load(save_file_path);

    if isfield(ExistingLoad,'BadTrials')

        existing_bad_trials = ExistingLoad.BadTrials;

        if iscell(existing_bad_trials)

            if numel(existing_bad_trials) > nChannels
                error(['Existing BadTrials contains %d channel cells, but ' ...
                    'the current dataset contains %d channel indices.'], ...
                    numel(existing_bad_trials),nChannels);
            end

            BadTrials(1:numel(existing_bad_trials)) = ...
                existing_bad_trials(:);

        elseif isnumeric(existing_bad_trials)

            % Support an older file containing one global numeric list
            for channel_index = 1:nChannels
                BadTrials{channel_index} = ...
                    existing_bad_trials(:);
            end

        else
            error(['Existing BadTrials must be either a cell array or ' ...
                'a numeric global trial list.']);
        end
    end

    if isfield(ExistingLoad,'BadTrialHistory')
        ExistingBadTrialHistory = ...
            ExistingLoad.BadTrialHistory;
    end

    fprintf('Existing bad-trial file found: %s\n',bad_filename);

else
    fprintf('A new bad-trial file will be created: %s\n', ...
        bad_filename);
end

%% ================= NORMALIZE EXISTING BAD TRIALS ======================

for channel_index = 1:nChannels

    this_list = BadTrials{channel_index};

    if isempty(this_list)
        BadTrials{channel_index} = [];
        continue;
    end

    if ~isnumeric(this_list)
        error('BadTrials{%d} is not numeric.',channel_index);
    end

    this_list = unique(double(this_list(:)));

    if any(~isfinite(this_list)) || ...
            any(this_list < 1) || ...
            any(fix(this_list) ~= this_list)

        error('BadTrials{%d} contains invalid trial IDs.', ...
            channel_index);
    end

    if any(~ismember(this_list,all_absolute_trial_ids))
        error(['BadTrials{%d} contains trial IDs that do not exist in ' ...
            'the current TrialSummary.'],channel_index);
    end

    BadTrials{channel_index} = this_list;
end

%% =====================================================================
% VALIDATE AND CONVERT EVERY REQUESTED CHANGE
%
% Nothing is saved during this section.
% If any entry is invalid, MATLAB stops before modifying the output file.
% ======================================================================

operations = empty_operation_array();

% Process removals first
new_operations = parse_global_entries( ...
    Global_Removals, ...
    'remove', ...
    TrialSummary, ...
    Amp_Tol_uA, ...
    PTD_Tol_ms, ...
    nChannels);

operations = [operations new_operations]; %#ok<AGROW>

new_operations = parse_channel_entries( ...
    Channel_Removals, ...
    'remove', ...
    TrialSummary, ...
    Amp_Tol_uA, ...
    PTD_Tol_ms, ...
    nChannels);

operations = [operations new_operations]; %#ok<AGROW>

% Process additions after removals
new_operations = parse_global_entries( ...
    Global_Additions, ...
    'add', ...
    TrialSummary, ...
    Amp_Tol_uA, ...
    PTD_Tol_ms, ...
    nChannels);

operations = [operations new_operations]; %#ok<AGROW>

new_operations = parse_channel_entries( ...
    Channel_Additions, ...
    'add', ...
    TrialSummary, ...
    Amp_Tol_uA, ...
    PTD_Tol_ms, ...
    nChannels);

operations = [operations new_operations]; %#ok<AGROW>

% Reject an instruction that tries to both add and remove the same
% absolute trial from the same channel during this run.
validate_no_conflicts(operations);

fprintf('\nAll requested entries passed validation.\n');

%% ======================= PRINT ALL CONVERSIONS ========================

fprintf('\n============================================================\n');
fprintf('VALIDATED TRIAL CONVERSIONS\n');
fprintf('============================================================\n');

if isempty(operations)

    fprintf('No additions or removals were entered.\n');

else
    for operation_index = 1:numel(operations)

        op = operations(operation_index);

        fprintf('\n%s %s\n', ...
            upper(op.scope), ...
            upper(op.action));

        fprintf('Set: %d | Amp: %g uA | PTD: %g ms\n', ...
            op.set_index, ...
            op.amplitude_uA, ...
            op.PTD_ms);

        fprintf('Condition trials: %s\n', ...
            number_list(op.condition_trial_indices));

        fprintf('Absolute trials:  %s\n', ...
            number_list(op.absolute_trial_ids));

        if strcmp(op.scope,'global')
            fprintf('Channels: all channels 1:%d\n',nChannels);
        else
            fprintf('Channels: %s\n', ...
                number_list(op.channel_indices));
        end
    end
end

%% ===================== APPLY CHANGES IN MEMORY ========================

number_added_channel_trial_pairs = 0;
number_removed_channel_trial_pairs = 0;

for operation_index = 1:numel(operations)

    op = operations(operation_index);

    for channel_index = op.channel_indices

        current_list = BadTrials{channel_index};
        current_list = unique(double(current_list(:)));

        if strcmp(op.action,'remove')

            before_count = numel(current_list);

            current_list = setdiff( ...
                current_list, ...
                op.absolute_trial_ids(:));

            removed_here = ...
                before_count-numel(current_list);

            number_removed_channel_trial_pairs = ...
                number_removed_channel_trial_pairs+removed_here;

        elseif strcmp(op.action,'add')

            before_count = numel(current_list);

            current_list = unique([ ...
                current_list; ...
                op.absolute_trial_ids(:)]);

            added_here = ...
                numel(current_list)-before_count;

            number_added_channel_trial_pairs = ...
                number_added_channel_trial_pairs+added_here;

        else
            error('Internal error: unsupported action %s.', ...
                op.action);
        end

        BadTrials{channel_index} = current_list;
    end
end

%% ========================== BUILD GoodTrials ==========================

GoodTrials = cell(nChannels,1);

for channel_index = 1:nChannels

    GoodTrials{channel_index} = setdiff( ...
        all_absolute_trial_ids(:), ...
        BadTrials{channel_index}(:));
end

%% ======================= GLOBAL BAD-TRIAL IDS =========================

% A trial is considered global only if it is present in every channel's
% BadTrials list.
if nChannels > 0

    GlobalBadTrialIDs = BadTrials{1}(:);

    for channel_index = 2:nChannels

        GlobalBadTrialIDs = intersect( ...
            GlobalBadTrialIDs, ...
            BadTrials{channel_index}(:));
    end

    GlobalBadTrialIDs = unique(GlobalBadTrialIDs);

else
    GlobalBadTrialIDs = [];
end

% Trials marked bad in at least one channel
AnyChannelBadTrialIDs = [];

for channel_index = 1:nChannels

    AnyChannelBadTrialIDs = union( ...
        AnyChannelBadTrialIDs, ...
        BadTrials{channel_index}(:));
end

AnyChannelBadTrialIDs = unique(AnyChannelBadTrialIDs);

%% ============================ SAVE HISTORY ============================

history_entry = struct();

history_entry.timestamp = char(datetime( ...
    'now','Format','yyyy-MM-dd HH:mm:ss'));

history_entry.source_count_file = count_file;
history_entry.operations = operations;

history_entry.added_channel_trial_pairs = ...
    number_added_channel_trial_pairs;

history_entry.removed_channel_trial_pairs = ...
    number_removed_channel_trial_pairs;

if isempty(ExistingBadTrialHistory)

    BadTrialHistory = history_entry;

else
    BadTrialHistory = ExistingBadTrialHistory;
    BadTrialHistory(end+1) = history_entry;
end

%% ============================= SAVE FILE ==============================

% Every entry has already been validated. Back up the existing file now.
if isfile(save_file_path) && Create_Backup_If_Output_Exists

    timestamp = datestr(now,'yyyymmdd_HHMMSS');

    backup_filename = sprintf( ...
        '%s.MultiISIsBadTrials_BACKUP_%s.mat', ...
        base_name,timestamp);

    backup_path = fullfile(data_folder,backup_filename);

    copyfile(save_file_path,backup_path);

    fprintf('\nExisting bad-trial file backed up to:\n%s\n', ...
        backup_path);
end

Created = char(datetime( ...
    'now','Format','yyyy-MM-dd HH:mm:ss'));

SourceTrialCountFile = count_file;
N_Trials = nTrials;
N_Channels = nChannels;

save(save_file_path, ...
    'BadTrials', ...
    'GoodTrials', ...
    'GlobalBadTrialIDs', ...
    'AnyChannelBadTrialIDs', ...
    'BadTrialHistory', ...
    'Created', ...
    'SourceTrialCountFile', ...
    'N_Trials', ...
    'N_Channels', ...
    '-v7.3');

%% =========================== FINAL SUMMARY ============================

bad_counts_per_channel = cellfun( ...
    @numel,BadTrials);

fprintf('\n============================================================\n');
fprintf('BAD-TRIAL UPDATE COMPLETE\n');
fprintf('============================================================\n');
fprintf('Output file:\n%s\n',save_file_path);
fprintf('New channel-trial pairs added: %d\n', ...
    number_added_channel_trial_pairs);
fprintf('Existing channel-trial pairs removed: %d\n', ...
    number_removed_channel_trial_pairs);
fprintf('Global bad trials: %d\n',numel(GlobalBadTrialIDs));
fprintf('Trials bad in at least one channel: %d\n', ...
    numel(AnyChannelBadTrialIDs));
fprintf('Minimum bad trials in one channel: %d\n', ...
    min(bad_counts_per_channel));
fprintf('Maximum bad trials in one channel: %d\n', ...
    max(bad_counts_per_channel));
fprintf('Original spike and experiment files modified: NO\n');
fprintf('============================================================\n');

%% =========================== LOCAL FUNCTIONS ==========================

function operations = empty_operation_array()
% Create an empty operation structure with fixed fields.

operations = struct( ...
    'action',{}, ...
    'scope',{}, ...
    'set_index',{}, ...
    'amplitude_uA',{}, ...
    'PTD_ms',{}, ...
    'condition_trial_indices',{}, ...
    'absolute_trial_ids',{}, ...
    'channel_indices',{});
end

function operations = parse_global_entries( ...
    entries,action,TrialSummary,AmpTol,PTDTol,nChannels)
% Validate and convert global change entries.
%
% Entry format:
%   {Set, Amp_uA, PTD_ms, [ConditionTrialIndices]}

operations = empty_operation_array();

if isempty(entries)
    return;
end

if ~iscell(entries) || size(entries,2) ~= 4
    error(['Global %s entries must be a cell array with four columns:\n' ...
        '{Set, Amp_uA, PTD_ms, [ConditionTrialIndices]}'], ...
        action);
end

for row_index = 1:size(entries,1)

    set_index = validate_positive_integer_scalar( ...
        entries{row_index,1}, ...
        sprintf('Global %s row %d Set',action,row_index));

    amplitude_uA = validate_finite_scalar( ...
        entries{row_index,2}, ...
        sprintf('Global %s row %d Amp',action,row_index));

    PTD_ms = validate_finite_scalar( ...
        entries{row_index,3}, ...
        sprintf('Global %s row %d PTD',action,row_index));

    condition_trial_indices = validate_index_vector( ...
        entries{row_index,4}, ...
        sprintf('Global %s row %d trial list', ...
        action,row_index));

    if isempty(condition_trial_indices)
        continue;
    end

    absolute_trial_ids = map_condition_trials( ...
        TrialSummary, ...
        set_index, ...
        amplitude_uA, ...
        PTD_ms, ...
        condition_trial_indices, ...
        AmpTol, ...
        PTDTol);

    op = struct();

    op.action = action;
    op.scope = 'global';
    op.set_index = set_index;
    op.amplitude_uA = amplitude_uA;
    op.PTD_ms = PTD_ms;

    op.condition_trial_indices = ...
        condition_trial_indices;

    op.absolute_trial_ids = ...
        absolute_trial_ids;

    op.channel_indices = 1:nChannels;

    operations(end+1) = op; %#ok<AGROW>
end
end

function operations = parse_channel_entries( ...
    entries,action,TrialSummary,AmpTol,PTDTol,nChannels)
% Validate and convert channel-specific change entries.
%
% Entry format:
%   {Set, Amp_uA, PTD_ms, [ChannelIndices], ...
%       [ConditionTrialIndices]}

operations = empty_operation_array();

if isempty(entries)
    return;
end

if ~iscell(entries) || size(entries,2) ~= 5
    error(['Channel-specific %s entries must be a cell array with ' ...
        'five columns:\n' ...
        '{Set, Amp_uA, PTD_ms, [ChannelIndices], ' ...
        '[ConditionTrialIndices]}'], ...
        action);
end

for row_index = 1:size(entries,1)

    set_index = validate_positive_integer_scalar( ...
        entries{row_index,1}, ...
        sprintf('Channel %s row %d Set',action,row_index));

    amplitude_uA = validate_finite_scalar( ...
        entries{row_index,2}, ...
        sprintf('Channel %s row %d Amp',action,row_index));

    PTD_ms = validate_finite_scalar( ...
        entries{row_index,3}, ...
        sprintf('Channel %s row %d PTD',action,row_index));

    channel_indices = validate_index_vector( ...
        entries{row_index,4}, ...
        sprintf('Channel %s row %d channel list', ...
        action,row_index));

    condition_trial_indices = validate_index_vector( ...
        entries{row_index,5}, ...
        sprintf('Channel %s row %d trial list', ...
        action,row_index));

    if isempty(channel_indices) && ...
            ~isempty(condition_trial_indices)

        error('Channel %s row %d has trials but no channels.', ...
            action,row_index);
    end

    if any(channel_indices > nChannels)
        error(['Channel %s row %d contains a channel greater than ' ...
            'the available maximum channel index %d.'], ...
            action,row_index,nChannels);
    end

    if isempty(channel_indices) || ...
            isempty(condition_trial_indices)

        continue;
    end

    absolute_trial_ids = map_condition_trials( ...
        TrialSummary, ...
        set_index, ...
        amplitude_uA, ...
        PTD_ms, ...
        condition_trial_indices, ...
        AmpTol, ...
        PTDTol);

    op = struct();

    op.action = action;
    op.scope = 'channel';
    op.set_index = set_index;
    op.amplitude_uA = amplitude_uA;
    op.PTD_ms = PTD_ms;

    op.condition_trial_indices = ...
        condition_trial_indices;

    op.absolute_trial_ids = ...
        absolute_trial_ids;

    op.channel_indices = channel_indices;

    operations(end+1) = op; %#ok<AGROW>
end
end

function absolute_trial_ids = map_condition_trials( ...
    TrialSummary,set_index,amplitude_uA,PTD_ms, ...
    condition_trial_indices,AmpTol,PTDTol)
% Convert condition-relative trial rows to original absolute trial IDs.

condition_mask = ...
    TrialSummary.SetIndex == set_index & ...
    abs(TrialSummary.Amplitude_uA-amplitude_uA) < AmpTol & ...
    abs(TrialSummary.PTD_ms-PTD_ms) < PTDTol;

if ~any(condition_mask)

    error(['Condition not found: Set %d | Amp %g uA | PTD %g ms.'], ...
        set_index,amplitude_uA,PTD_ms);
end

absolute_trial_ids = ...
    zeros(size(condition_trial_indices));

for trial_position = 1:numel(condition_trial_indices)

    condition_trial_index = ...
        condition_trial_indices(trial_position);

    trial_mask = ...
        condition_mask & ...
        TrialSummary.ConditionTrialIndex == ...
        condition_trial_index;

    number_of_matches = sum(trial_mask);

    if number_of_matches == 0

        available_indices = ...
            TrialSummary.ConditionTrialIndex(condition_mask);

        error(['Condition trial %d does not exist for Set %d | ' ...
            'Amp %g uA | PTD %g ms. Available condition trials: %s'], ...
            condition_trial_index, ...
            set_index, ...
            amplitude_uA, ...
            PTD_ms, ...
            number_list(available_indices(:).'));

    elseif number_of_matches > 1

        error(['Condition trial %d matched more than one row for ' ...
            'Set %d | Amp %g uA | PTD %g ms.'], ...
            condition_trial_index, ...
            set_index, ...
            amplitude_uA, ...
            PTD_ms);
    end

    absolute_trial_ids(trial_position) = ...
        TrialSummary.AbsoluteTrialID(trial_mask);
end

absolute_trial_ids = ...
    unique(double(absolute_trial_ids(:).'),'stable');
end

function value = validate_positive_integer_scalar(value,label)
% Validate one positive integer scalar.

if ~isnumeric(value) || ...
        ~isscalar(value) || ...
        ~isfinite(value) || ...
        value < 1 || ...
        fix(value) ~= value

    error('%s must be a positive integer scalar.',label);
end

value = double(value);
end

function value = validate_finite_scalar(value,label)
% Validate one finite numeric scalar.

if ~isnumeric(value) || ...
        ~isscalar(value) || ...
        ~isfinite(value)

    error('%s must be one finite numeric scalar.',label);
end

value = double(value);
end

function values = validate_index_vector(values,label)
% Validate a vector of positive integer indices.

if isempty(values)
    values = [];
    return;
end

if ~isnumeric(values) || ...
        ~isvector(values) || ...
        any(~isfinite(values)) || ...
        any(values < 1) || ...
        any(fix(values) ~= values)

    error('%s must contain positive integer indices.',label);
end

values = unique(double(values(:).'),'stable');
end

function validate_no_conflicts(operations)
% Reject additions and removals that target the same absolute trial and
% channel during the same execution.

add_keys = strings(0,1);
remove_keys = strings(0,1);

for operation_index = 1:numel(operations)

    op = operations(operation_index);

    [channel_grid,trial_grid] = ndgrid( ...
        op.channel_indices, ...
        op.absolute_trial_ids);

    keys = ...
        string(channel_grid(:))+"_"+string(trial_grid(:));

    if strcmp(op.action,'add')
        add_keys = [add_keys; keys]; %#ok<AGROW>
    else
        remove_keys = [remove_keys; keys]; %#ok<AGROW>
    end
end

conflicting_keys = intersect( ...
    unique(add_keys), ...
    unique(remove_keys));

if ~isempty(conflicting_keys)

    error(['The current input tries to both add and remove %d of the ' ...
        'same channel/trial combinations. Resolve these conflicts ' ...
        'before running the script.'], ...
        numel(conflicting_keys));
end
end

function output = number_list(values)
% Convert a numeric vector into readable command-window text.

if isempty(values)
    output = '(none)';
else
    output = strtrim(sprintf('%g ',values));
end
end